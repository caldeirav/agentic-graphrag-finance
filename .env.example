# Required for SEC EDGAR downloads (fair-access policy: name + email)
SEC_EDGAR_USER_AGENT=Your Name your.email@example.com
EDGAR_REQUESTS_PER_SECOND=8
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.6-35b-a3b
GOOGLE_API_KEY=your_gemini_api_key_here
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
USE_MOCK_LLM=0
USE_MOCK_JUDGE=0
# Set to 1 in CI to use tests/fixtures/sec_downloads instead of live EDGAR
USE_FIXTURE_INGESTION=0
