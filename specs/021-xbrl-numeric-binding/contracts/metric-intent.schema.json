{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricIntent",
  "type": "object",
  "required": ["metric_type", "metric_label", "periods_needed"],
  "properties": {
    "metric_type": {
      "type": "string",
      "enum": ["point", "delta", "ratio", "percent_change"]
    },
    "metric_label": { "type": "string", "minLength": 1 },
    "required_concepts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "periods_needed": { "type": "integer", "minimum": 1, "maximum": 2 },
    "formula": { "type": "string" }
  },
  "additionalProperties": false
}
